# ==========================================================================
# Copy to .env and fill in.  Check it any time with:  python -m scripts.doctor
# ==========================================================================

# --------------------------------------------------------------------------
# REQUIRED
# --------------------------------------------------------------------------

# Neon > your project > Connection Details > "Pooled connection".
# Paste it exactly as Neon gives it. A plain postgres:// URL is upgraded to
# postgresql+asyncpg:// automatically.
#
# For a zero-setup local run, use SQLite instead:
#   DATABASE_URL=sqlite+aiosqlite:///./local.db
#
# The app does NOT create tables. Run:  alembic upgrade head
DATABASE_URL=

# Any long random string. Used for future session signing.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --------------------------------------------------------------------------
# TELEGRAM  (optional - the app runs without these, ingestion just stays off)
# --------------------------------------------------------------------------

# From @BotFather
TELEGRAM_BOT_TOKEN=

# The group's numeric chat id. Easiest: forward any message to @userinfobot.
# Leave blank to accept messages from any chat (not recommended).
TELEGRAM_CHAT_ID=

# OPTIONAL extra guard on the webhook. Not required - the webhook already
# rejects any chat id that does not match TELEGRAM_CHAT_ID. Set it if you want
# a second layer: Telegram then sends it as X-Telegram-Bot-Api-Secret-Token.
# TELEGRAM_WEBHOOK_SECRET=

# Public URL of this deployment, used by scripts/setup_webhook.py.
# Set this AFTER the first deploy:
#   WEBHOOK_URL=https://samruddhi-fin.onrender.com/webhook/telegram
WEBHOOK_URL=

# --------------------------------------------------------------------------
# APP
# --------------------------------------------------------------------------

APP_ENV=development

# Where this app is deployed. Only used by scripts/setup_webhook.py, which you
# run locally - it does NOT need to be set on Render.
#   WEBHOOK_URL=https://samruddhi-fin.onrender.com/webhook/telegram
WEBHOOK_URL=

# Pin the Python version locally too, to match Render.
PYTHON_VERSION=3.12.9